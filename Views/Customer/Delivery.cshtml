
<div class="d-flex justify-content-center align-items-center position-absolute top-50 start-50 translate-middle" style="width: 100%; height: 100vh;">

    <form asp-action="OrderSummary" method="post" class="text-center p-4 rounded-4 shadow-lg bg-white" style="max-width: 450px; width: 100%; border-radius: 15px;">
        
        <h1 class="mb-4 fw-bold" style="font-size: 2rem; letter-spacing: 1px;">Choisissez votre option</h1>

        <div class="d-flex flex-column justify-content-between mb-4">

            <button type="submit" name="Option" value="false" class="btn btn-primary btn-lg px-4 py-3 rounded-4 shadow-sm mb-3 w-100">
                🍽 Sur place
            </button>

            @if(Convert.ToDouble(TempData["distance"]) <= 12) //en km
            {
                <button type="submit" name="Option" value="true" class="btn btn-success btn-lg px-4 py-3 rounded-4 shadow-sm w-100">
                    🚚 Livraison
                </button>
            }
            else
            {
                <a>La livraison n’est pas disponible à votre adresse</a>
            }

        </div>

    </form>
</div>

<style>
    body, html {
        height: 100%;
        margin: 0;
        padding: 0;
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #ffffff, #e9ecef);
    }

    .btn {
        transition: all 0.2s ease-in-out;
        border-radius: 15px;
    }

    .btn-primary:hover, .btn-success:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 18px rgba(0, 0, 0, 0.1);
    }

    .hover-grow {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .hover-grow:hover {
        transform: scale(1.05);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    }
</style>
