@model List<Order>

<h2 class="text-center mb-5 text-success fw-bold">Statut de vos commandes</h2>

@foreach (var order in Model)
{
        <div class="commande card shadow-sm mb-4 border-light">
            <div class="card-body">
                <h4 class="card-title text-success">Commande n°@order.OrderNumber</h4>
                <p><strong>Date :</strong> @order.OrderTime.ToString("g")</p>
                <p><strong>Restaurant :</strong> @order.Restaurant.Name</p>
            <p><strong>Prix total :</strong> @order.CalculateTotalPrice() euros</p> 
                <p><strong>Statut :</strong> @order.Status</p>
                


            @if (order.Status.ToString() == "ReadyForPickup")
            {
                        <div class="alert alert-success mt-2" role="alert">
                            ✅ Votre commande est prête à être retirée !
                        </div>
            }
            else if (order.Status.ToString() == "OrderCompleted")
            {
                        <div class="alert alert-info mt-2" role="alert">
                            🧾 Commande complétée.
                        </div>
            }

                <h5 class="mt-3">Plats commandés :</h5>
                <ul class="list-group">
                @foreach (var selectedMeal in order.Meals)
                {
                            <li class="list-group-item">
                        @selectedMeal.Key.Name - Quantité : @selectedMeal.Value
                            </li>
                }
                </ul>
            </div>
        </div>
}

<form method="get" asp-action="ViewStatutOrder">
    <div class="text-center mt-4">
        <button type="submit" class="btn btn-success btn-lg px-4 py-2 rounded-4 shadow-sm">
            🔄 Actualiser mes commandes
        </button>
    </div>
</form>

