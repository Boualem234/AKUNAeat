@model AKUNAeat.ViewModels.MealSelectionViewModel


<form asp-action="SubmitMealQuantities" method="post">
    <div class="row g-4 mb-5 justify-content-center">


        @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
        {
            <div class="alert alert-danger text-center">
                @TempData["ErrorMessage"]
            </div>
        }

        @for (int i = 0; i < Model.Selections.Count; i++)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-success fw-bold">
                            @Model.Selections[i].Meal.Name
                        </h5>
                        <p class="card-text text-muted">
                            <strong>Prix :</strong> @Model.Selections[i].Meal.Price €
                        </p>

                        <input asp-for="Selections[@i].Meal.MealId" type="hidden" />
                        <input asp-for="Selections[@i].Meal.Name" type="hidden" />
                        <input asp-for="Selections[@i].Meal.Price" type="hidden" />

                        <div class="mt-auto">
                            <label asp-for="Selections[@i].Quantity" class="form-label fw-semibold text-center w-100">Quantité</label>
                            <div class="d-flex justify-content-center align-items-center gap-2 quantity-wrapper">
                                <button type="button" class="btn btn-success quantity-btn rounded-circle" onclick="decrement(@i)">
                                    <strong>−</strong>
                                </button>
                                <input asp-for="Selections[@i].Quantity" min="0" class="form-control text-center quantity-input" />
                                <button type="button" class="btn btn-success quantity-btn rounded-circle" onclick="increment(@i)">
                                    <strong>+</strong>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="fixed-bottom bg-white border-top p-3 d-flex justify-content-end shadow-lg">
        <button type="submit" class="btn btn-success btn-lg px-4 rounded-pill shadow">
            ✅ Envoyer la commande
        </button>
    </div>
</form>

<script>
    function increment(index) {
        const input = document.querySelectorAll('.quantity-input')[index];
        let value = parseInt(input.value) || 0;
        input.value = value + 1;
    }

    function decrement(index) {
        const input = document.querySelectorAll('.quantity-input')[index];
        let value = parseInt(input.value) || 0;
        if (value > 0) {
            input.value = value - 1;
        }
    }
</script>