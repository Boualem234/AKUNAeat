@model Order


<div class="container py-5">
    <h1 class="text-center mb-5 fw-bold text-primary" style="font-size: 2rem;">Résumé de votre commande</h1>

    <form asp-action="OrderConfirmation" method="post">



        <!-- Cartes affichées à l'utilisateur -->
        <!-- Restaurant Info -->
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Restaurant</h5>
            </div>
            <div class="card-body">
                <p class="card-text">Nom du restaurant : <strong>@Model.Restaurant.Name</strong></p>
            </div>
        </div>

        <!-- Meals Info -->
        <div class="card shadow-sm mb-4 border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Plats / Menus</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var meal in Model.Meals)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@meal.Key</span>
                            <span class="badge bg-light text-dark">Quantité: @meal.Value</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Service Info -->
        <div class="card shadow-sm mb-4 border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Service</h5>
            </div>
            <div class="card-body">
                <p class="card-text"><strong>Service :</strong> @Model.Service</p>
            </div>
        </div>
        <!-- Prix total -->
        <div class="card shadow-sm mb-4 border-dark">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Prix Total</h5>
            </div>
            <div class="card-body">
                <p class="card-text"><strong>@Model.CalculateTotalPrice() @if(Model.IsDelivery){<text> avec frais de livraison (4 €)</text>}</strong></p>
            </div>
        </div>
        <!-- Option Info -->
        <div class="card shadow-sm mb-4 border-warning">
            <div class="card-header bg-warning text-white">
                <h5 class="mb-0">Option</h5>
            </div>
            <div class="card-body">
                <p class="card-text">Option choisie : <strong> @(Model.IsDelivery ? "Livraison" : "Sur place") </strong></p>
            </div>
        </div>

        <!-- Buttons -->
        <div class="text-center">
            <button type="submit" class="btn btn-success btn-lg px-5 py-3 rounded-pill shadow-sm mb-3">
                Confirmer la commande
            </button>
            <a class="btn btn-danger btn-lg px-5 py-3 rounded-pill shadow-sm" asp-action="CancelOrder">
                Annuler la commande
            </a>
        </div>
    </form>
</div>

<style>
    .btn {
        transition: all 0.2s ease-in-out;
        font-weight: 600;
    }

    .btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .card {
        border-radius: 10px;
    }

    .list-group-item {
        border: 1px solid #ddd;
        border-radius: 8px;
    }

    .container {
        font-family: 'Poppins', sans-serif;
    }
</style>
