@model List<Restaurant>

<div class="container py-5">
    <h1 class="text-center mb-5 text-success fw-bold">Restaurants disponibles</h1>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <h4 class="alert-heading">🎉 Succès !</h4>
                        <p>@TempData["SuccessMessage"]</p>
                        <hr>
                        <p class="mb-0">Merci pour votre commande. Vous pouvez consulter votre historique à tout moment.</p>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                else if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <h4 class="alert-heading">❌ Oups !</h4>
                        <p>@TempData["ErrorMessage"]</p>
                        <hr>
                        <p class="mb-0">Veuillez réessayer ou contacter le support si le problème persiste.</p>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }


            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
            <div class="alert alert-warning text-center fs-5">
                Aucun restaurant disponible pour le moment.
            </div>
    }
    else
    {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var restaurant in Model)
            {
                        <div class="col">
                            <div class="card shadow-sm h-100 border-0">
                                <div class="card-body">
                                    <h5 class="card-title text-success fw-bold">@restaurant.Name</h5>
                                    <p class="card-text mb-1">
                                        <i class="bi bi-geo-alt-fill me-1 text-secondary"></i> @restaurant.Address
                                    </p>
                                    <p class="card-text text-muted fst-italic">@restaurant.CuisineType</p>
                                    <a asp-controller="Customer"
                                       asp-action="DetailsRestaurant"
                                       asp-route-id="@restaurant.RestaurantId"
                                       class="btn btn-outline-orange w-100 mt-3">
                                        Voir les détails
                                    </a>
                                </div>
                            </div>
                        </div>
            }
            </div>

            <!-- Pagination -->
            <nav class="mt-5" aria-label="Pagination des restaurants">
                <ul class="pagination justify-content-center">
                @if (Convert.ToInt32(ViewData["CurrentPage"]) > 1)
                {
                            <li class="page-item">
                                <a class="page-link text-white bg-success" asp-controller="Customer" asp-action="ListRestaurants" asp-route-page="@(Convert.ToInt32(ViewData["CurrentPage"]) - 1)">
                                    Précédent
                                </a>
                            </li>
                }

                @for (int i = 1; i <= Convert.ToInt32(ViewData["TotalPages"]); i++)
                {
                            <li class="page-item @(i == Convert.ToInt32(ViewData["CurrentPage"]) ? "active" : "")">
                                <a class="page-link @(i == Convert.ToInt32(ViewData["CurrentPage"]) ? "bg-success text-white" : "")"
                                   asp-controller="Customer" asp-action="ListRestaurants" asp-route-page="@i">@i</a>
                            </li>
                }

                @if (Convert.ToInt32(ViewData["CurrentPage"]) < Convert.ToInt32(ViewData["TotalPages"]))
                {
                            <li class="page-item">
                                <a class="page-link text-white bg-success" asp-controller="Customer" asp-action="ListRestaurants" asp-route-page="@(Convert.ToInt32(ViewData["CurrentPage"]) + 1)">
                                    Suivant
                                </a>
                            </li>
                }
                </ul>
            </nav>
    }
</div>
