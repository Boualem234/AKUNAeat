@model Restaurant

<div class="container py-5">
    <h1 class="text-center text-success fw-bold mb-5">Détails du Restaurant</h1>

    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
    {
            <div class="alert alert-danger text-center">
            @TempData["ErrorMessage"]
            </div>
    }

    @if (Model == null)
    {
            <div class="alert alert-warning text-center fs-5">
                Les détails du restaurant ne sont pas disponibles.
            </div>
    }
    else
    {
            <div class="card shadow-lg border-0 rounded-4 p-4 mb-4">
                <div class="card-body">
                    <h2 class="card-title text-success">@Model.Name</h2>
                    <hr />
                    <p><i class="bi bi-geo-alt-fill text-secondary me-2"></i><strong>Adresse :</strong> @Model.Address</p>
                    <p><i class="bi bi-tag-fill text-secondary me-2"></i><strong>Type de Cuisine :</strong> @Model.CuisineType</p>
                    <p><i class="bi bi-info-circle-fill text-secondary me-2"></i><strong>Description :</strong> @Model.Description</p>
                    <p><i class="bi bi-telephone-fill text-secondary me-2"></i><strong>Téléphone :</strong> @Model.PhoneNumber</p>
                    <p><i class="bi bi-clock-fill text-secondary me-2"></i><strong>Heures :</strong> @Model.OpeningHours - @Model.ClosingHours</p>
                </div>
            </div>

        @if (Model.Services != null && Model.Services.Any())
        {
                    <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
                        <div class="card-body">
                            <h4 class="text-orange">Services proposés</h4>
                            <ul class="list-group list-group-flush mt-3">
                        @foreach (var service in Model.Services)
                        {
                                        <li class="list-group-item">
                                            <strong>Type :</strong> @service.ServiceType<br />
                                            <strong>Heures :</strong> de @service.StartTime à @service.EndTime
                                        </li>
                        }
                            </ul>
                        </div>
                    </div>
        }

            <div class="d-flex flex-wrap gap-3 mt-4 justify-content-center">
                <a asp-controller="Customer" asp-action="MenusList" asp-route-restaurantId="@Model.RestaurantId" class="btn btn-outline-orange px-4 py-2 rounded-pill shadow-sm">Voir les menus</a>
                <a asp-controller="Customer" asp-action="DishesList" asp-route-restaurantId="@Model.RestaurantId" class="btn btn-outline-orange px-4 py-2 rounded-pill shadow-sm">Voir les plats à la carte</a>
                <a asp-controller="Customer" asp-action="ListRestaurants" class="btn btn-outline-success px-4 py-2 rounded-pill shadow-sm">Retour à la liste</a>

                @if (ViewData["CustomerAccountId"] != null)
                {
                    <a asp-controller="Customer" asp-action="PLaceOrder" asp-route-restaurantId="@Model.RestaurantId" class="btn btn-success px-4 py-2 rounded-pill shadow-sm">Passer une commande</a>
                }

            </div>
    }
</div>

<!-- Custom Styles -->
<style>
    .text-orange {
        color: #fd7e14;
    }

    .btn-outline-orange {
        color: #fd7e14;
        border-color: #fd7e14;
    }

    .btn-outline-orange:hover {
        background-color: #fd7e14;
        color: white;
    }

    .card {
        background-color: #fff;
        border-radius: 1rem;
    }
</style>
