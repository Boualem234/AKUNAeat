@model List<Restaurant>

<div class="container my-5">
    <div class="text-center mb-4">
        <h1 class="display-5">Commencez votre aventure dès maintenant</h1>
        <a asp-action="AddRestaurant" class="btn btn-success btn-lg mt-3">
            Ajouter un restaurant
        </a>
    </div>

    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
    {
        <div class="alert alert-danger">
            <p>@TempData["ErrorMessage"]</p>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Il n'y a pas de restaurants actuellement.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var res in Model)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@res.Name</h5>
                            <p class="card-text text-muted">
                                Cuisine : @res.CuisineType<br />
                                @res.Address
                            </p>
                            <div class="mt-auto">
                                <a asp-action="ConnectExistingRestaurant" asp-route-restaurant_id="@res.RestaurantId" class="btn btn-primary w-100">
                                    Se connecter
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
