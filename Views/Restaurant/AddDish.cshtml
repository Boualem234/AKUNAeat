@model Dish

<div class="container mt-5" style="max-width: 600px;">
    <h2 class="mb-4 text-center">Ajouter un nouveau plat</h2>

    <form asp-action="AddDish" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Composition" class="form-label"></label>
            <input asp-for="Composition" class="form-control" />
            <span asp-validation-for="Composition" class="text-danger"></span>
        </div>

        <div class="d-grid gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Ajouter le plat</button>
        </div>
    </form>

    <div class="mt-3">
        <a asp-action="IndexRestaurantManagement" class="btn btn-secondary">Retour</a>
    </div>
</div>
