@model AKUNAeat.ViewModels.LoginViewModel

<form asp-action="@ViewData["Action"]" method="post">
    <table style="border-collapse: collapse;">
        <tr>
            <td style="padding-right: 12px;"><label for="Email">Email</label></td>
            <td style="padding-right: 12px;"><input asp-for="Email" type="email" class="form-control" /></td>
            <td><span asp-validation-for="Email" class="text-danger"></span></td>
        </tr>
        <tr><td colspan="3" style="height: 25px;"></td></tr>

        <tr>
            <td style="padding-right: 12px;"><label for="Password">Mot de passe</label></td>
            <td style="padding-right: 12px;"><input asp-for="Password" type="password" class="form-control" /></td>
            <td><span asp-validation-for="Password" class="text-danger"></span></td>
        </tr>

        <tr><td colspan="3" style="height: 25px;"></td></tr>

        <tr>
            <td></td>
            <td><button type="submit" class="btn btn-primary">Se connecter</button></td>
        </tr>
    </table>

    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
    {
        <div class="alert alert-danger alert-dismissible fade show small" role="alert">
            ❌ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

</form>
